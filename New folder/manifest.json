
{
"manifest_version": 3,
"name": "TeamLogger Website Monitor",
"version": "1.1.0",
"description": "Monitors active Chrome websites for TeamLoggerC.",
"permissions": [
"tabs",
"storage"
],
"host_permissions": [
"http://localhost:8080/*",
"http://127.0.0.1:8080/*"
],
"background": {
"service_worker": "background.js"
},
  "action": {
  "default_title": "TeamLogger Website Monitor",
  "default_popup": "popup.html"
}
}
